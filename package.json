{
  "name": "hishab",
  "version": "1.0.0",
  "description": "Hishab — personal finance tracker",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "cf-typegen": "wrangler types src/worker-configuration.d.ts && sed -i \"/mainModule: typeof import(\\\".*_worker\\\")/d\" src/worker-configuration.d.ts",
    "db:migrate:local": "wrangler d1 migrations apply hishab --local",
    "db:migrate:remote": "wrangler d1 migrations apply hishab --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "type": "module",
  "dependencies": {
    "chart.js": "^4.5.1",
    "jose": "^6.2.12",
    "nanoid": "^6.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261003.1",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20261001.1": true
  },
  "private": true
}
