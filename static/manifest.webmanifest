{
	"name": "Hishab",
	"short_name": "Hishab",
	"description": "Personal finance tracker",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#fbf1c7",
	"theme_color": "#fbf1c7",
	"shortcuts": [
		{ "name": "Add expense", "short_name": "Expense", "url": "/?add=expense", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
		{ "name": "Add income", "short_name": "Income", "url": "/?add=income", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
		{ "name": "Transfer", "short_name": "Transfer", "url": "/?add=transfer", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
	],
	"icons": [
		{ "src": "/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
		{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
		{ "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
		{ "src": "/icon-512-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
	]
}
