{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "hishab",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	// Only reachable on the custom domain (behind Cloudflare Access); no public *.workers.dev URL.
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "hishab.mirazulislamnahid.com", "custom_domain": true }],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "hishab",
			"database_id": "2f56dcb8-98f2-4771-81f8-9e6cd3cf114f",
			"migrations_dir": "migrations"
		}
	],
	"observability": { "enabled": true },
	"vars": {
		// Cloudflare Access: fill in after creating the Access application, then redeploy.
		// Until both are set the API refuses every request (fails closed).
		"ACCESS_TEAM_DOMAIN": "small-mode-495b.cloudflareaccess.com",
		"ACCESS_AUD": "6f7e656bc0230471eb830680594ea70727bddff77e1fb86e991a1f73306e7b84"
	}
}
